				Name="VCPreLinkEventTool"
			/>
			<Tool
				Name="VCLinkerTool"
				AdditionalOptions="-fno-exceptions"
				AdditionalDependencies="-lfs_stub -lmixer -laudio_stub -lmic_stub -lsysmodule_stub &quot;..\..\..\lib\ps3\VoiceCmds.a&quot; &quot;$(SN_PS3_PATH)\ppu\lib\sn\libsn.a&quot; &quot;$(SCE_PS3_ROOT)\target\ppu\lib\libm.a&quot; &quot;$(SCE_PS3_ROOT)\target\ppu\lib\libio_stub.a&quot;"
				OutputFile="$(OutDir)/$(ProjectName).ppu.elf"
				LinkIncremental="0"
				AdditionalLibraryDirectories=""
				GenerateManifest="false"
				ProgramDatabaseFile=""
			/>
			<Tool
				Name="VCALinkTool"
			/>
			<Tool
				Name="VCManifestTool"
			/>
