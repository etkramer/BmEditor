<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<!-- BM: Run on .NET 4.x when present. 3.5 is an optional feature on modern Windows, and
	     Binaries\Ionic.Zip.Reduced.dll is a 4.0 build that cannot load on CLR 2. -->
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0"/>
		<supportedRuntime version="v2.0.50727"/>
	</startup>
	<runtime>
		<generatePublisherEvidence enabled="false"/>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<probing privatePath="InstallData"/>
		</assemblyBinding>
	</runtime>
</configuration>
