<?xml version="1.0" encoding="utf-8" ?>
<configuration>

	<!-- BM: host CLR 4.0 so the v4-targeted Swarm assemblies load. useLegacyV2RuntimeActivationPolicy
	     lets the VS2008-built mixed-mode/CLR code bind to it. -->
	<startup useLegacyV2RuntimeActivationPolicy="true">
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0"/>
	</startup>

	<runtime>

		<!-- Make sure that we don't "phone home" to verify digital signatures (can slow down startup time) -->
		<generatePublisherEvidence enabled="false"/>

	</runtime>
</configuration>
