//---------------------------------------------
// Sample aberrated colour, and depth
//---------------------------------------------
half4 CalcSceneColorAndDepthOptionalAberration( in half2 UV )
{
	half4 FocusedSceneColorAndDepth = CalcSceneColorAndDepth( UV );
//Aberration:
#if LOCAL_ABERRATION
	//Size in screen space pixels:
	#define AberrationSize 1
	#define AberrationDoubleSize 2

	FocusedSceneColorAndDepth.r = CalcFullSceneColor( UV * (1.h - BufferTexelSizeXY.xy * AberrationDoubleSize) + BufferTexelSizeXY.xy * AberrationSize).r;

#endif //LOCAL_ABERRATION

	return FocusedSceneColorAndDepth;
}

//---------------------------------------------
// Return the DOF mask with near/far sign:
//---------------------------------------------
half CalcSignedUnfocusedPercent(half SceneDepth)
{
	// Blur amount based on ratio of distance to focus plane to the focus radius
	// it is clamped to [-1,1]. Note that FocusDistance can be negative if it 
	// falls behind the near plane.
	half RelativeDistance = SceneDepth - FocusDistance;
	half DistanceSign = sign(RelativeDistance);

	//@Rock - JoelS: Fixed epic bug where DOF could never get to the min/max amount:
	half MaxUnfocusedPercent = (RelativeDistance < 0) ? MinMaxBlurClamp.x: MinMaxBlurClamp.y;

	return min(MaxUnfocusedPercent, pow(RelativeDistance * InverseFocusRadius, PackedParameters.z)) * DistanceSign;

	//float depth = SceneDepth; // = distance of pixel
	//float fDist = FocusDistance; // = point which we want to focus on
	//float fLength = 70.0; // = field of view
	//float fStop = 1.4; // = aperture of lens. usually 1.4 to 22
	//float result = depth*fLength / (depth-fLength);
	//result -= fDist*fLength / (fDist-fLength);
	//result *= (fDist-fLength) / (fDist*fStop);
	//return result;
}

//================================================================================================================================
// Pixel Shader
//================================================================================================================================
void Main(	in half4 ScreenPosition : TEXCOORD0,

			#if USE_IMAGEGRAIN
				in half4 FilterBufferUV : TEXCOORD1,
			#else
				in half2 FilterBufferUV : TEXCOORD1,
			#endif //USE_IMAGEGRAIN
			out half4 OutColor : COLOR0	)
{
//Setup initial colour, depth, and blur buffers:
	half2 UV = ScreenPosition.zw;
//Optional aberration:
	half4 FocusedSceneColorAndDepth = CalcSceneColorAndDepthOptionalAberration( UV.xy );
	//offset these UV's to match up the DOF anti-dither pass which collected 2x2 taps at 1/4 res: 
	half4 blurredSceneColorAndDepth = tex2D(BlurredImage,FilterBufferUV.xy + float2(2,-2)*BufferTexelSizeXY.xy).rgba;
	blurredSceneColorAndDepth *= 4.0h; //Changed from MAX_SCENE_COLOR to avoid float cast

//---------------------------------------------
// CREATE GRAIN:
//---------------------------------------------
#if USE_IMAGEGRAIN
	half3 imageGrain;
	#if LOCAL_COLOUREDIMAGEGRAIN
		imageGrain = dot(tex2D(PostProcessNoiseTexture, FilterBufferUV.zw).rgb, FilmGrain.xyz) + 0.5h;
	#else //LOCAL_COLOUREDIMAGEGRAIN
		imageGrain = tex2D(PostProcessNoiseTexture, FilterBufferUV.zw).rgb + 0.5h;
	#endif //LOCAL_COLOUREDIMAGEGRAIN
#endif // USE_IMAGEGRAIN

//---------------------------------------------
// MOTION BLUR & DEPTH OF FIELD:
//---------------------------------------------

// High quality (Cinematic and point effect)
//---------------------------------------------
#if USE_HIGHQUALITYDOF && PC_D3D
	// reference DOF (no motionblur, very inefficient but simple and best quality bokeh, not for production use, good to verify approximations and the possible look)
	half3 DOFResult;
	{
		// Radius can be tweaked to get bigger bokeh (slower) 1->3x3, 2-> 5x5, 3->7x7, 4->9x9
		// can be optimized by passing a clamped int
		const int DOFKernelSize = 6;
		const int PixelRadius = clamp(DOFKernelSize.x, 1, 14);

		// slight offset to avoid too regular disk shape
		const half2 PixelOffset = half2(0.25h, 0.25h); 
		// bias value tweaked to align with offset
		const half Bias = 0.37f;

		half CenterCircleRadius = CalcUnfocusedPercent(FocusedSceneColorAndDepth.a) * (PixelRadius + 1.h - Bias * 2.h) + Bias;

		half4 Accum = half4(0,0,0,0.00001h);
		LOOP for(int y = -PixelRadius; y <= PixelRadius; ++y)
		{
			LOOP for(int x = -PixelRadius; x <= PixelRadius; ++x)
			{
				const half2 PixelRel = half2(x,y) + PixelOffset; 

				half4 LocalSceneColorAndDepth = CalcSceneColorAndDepthOptionalAberration(UV.xy + MinMaxBlurClamp.zw * half2(x, y) );

				half CircleRadius = CalcUnfocusedPercent(LocalSceneColorAndDepth.a) * (PixelRadius + 1.h - Bias * 2.h) + Bias;

				// to avoid leaking into a sharper center pixel from behind (more correct but often not visible)/
				// in some cases it can looks better without
				if(CenterCircleRadius < CircleRadius && LocalSceneColorAndDepth.a > FocusedSceneColorAndDepth.a)
				{
					CircleRadius = CenterCircleRadius;
				}

				// soft comparison -> AA bokeh shape
				half LocalWeight = saturate( - (length(PixelRel) - CircleRadius));

				// bigger bokeh shapes become more transparent
				LocalWeight /= CircleRadius*CircleRadius;

				Accum += half4(LocalSceneColorAndDepth.rgb,1.h) * LocalWeight;
			}
		}
		// normalize
		DOFResult = Accum.rgb / Accum.w;
	}

	half3 FrontBuffer = DOFResult;


// High quality optimised (Cinematic and point effect)
//---------------------------------------------
	////const int PixelRadius = 4;
	////const int PixelDiameter = 9;

	//half CenterCircleRadius = CalcSignedUnfocusedPercent(FocusedSceneColorAndDepth.a); //CalcUnfocusedPercent(FocusedSceneColorAndDepth.a); //
	//half4 Accum = half4(FocusedSceneColorAndDepth.rgb/4, 0.25f);

	//LOOP for(int i = 0; i < HQDOFSAMPLES; i++)
	//{
	//	half2 SampleUV = UV.xy + HQDOFKernel[i].xy;

	//	half4 LocalSceneColorAndDepth = CalcSceneColorAndDepthOptionalAberration(SampleUV.xy);
	//	half LocalCircleRadius = CalcSignedUnfocusedPercent(LocalSceneColorAndDepth.a); //CalcUnfocusedPercent(LocalSceneColorAndDepth.a); //
	//	//half localNearFarPlane = sign(LocalCircleRadius);

	//	half tester = CenterCircleRadius;

	//	//tester = (CenterCircleRadius < LocalCircleRadius) // && (LocalSceneColorAndDepth.a < FocusedSceneColorAndDepth.a)
