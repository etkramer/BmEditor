//-----------------------------------------------
// Motion blur: custom motion blur vector values
//-----------------------------------------------
#if MOTION_BLUR
	half2 CalcMoBlurVector( half2 UV )
	{
		half3 DynamicVelocity	= tex2D( VelocityBuffer, UV.xy ).rgb;
		DynamicVelocity.xy		= DynamicVelocity.xy * 0.5h - 0.25h; //Velocity is stored as a divisor of 1/4

		return DynamicVelocity.xy;
	}
#endif //MOTION_BLUR

//-----------------------------------------------
// Custom tone mapping operators
//-----------------------------------------------
half3 CalcToneMapping( in half3 colIn )
{
//Select type of tone mapping:
	#define Gamma_Original			1
	#define Gamma_Reinhard			0
	#define Gamma_FilmicTonemapping	0
	#define Gamma_KodakTonemapping	0

	half3 finalOut;

//Regular Gamma:
	#if Gamma_Original
		finalOut = pow(colIn.rgb, 1.h / 2.2h);
	#endif

//Reinhard tone mapping:
	#if Gamma_Reinhard
		finalOut = pow(colIn.rgb / (colIn.rgb + 1.h), 1.h / 2.2h);
	#endif

//Kodak tone mapping:
	#if Gamma_KodakTonemapping
		finalOut = max(0, colIn - 0.004h);
		finalOut = (finalOut * (6.2h * finalOut + 0.5h)) / (finalOut * (6.2h * finalOut + 1.7h) + 0.06h);
	#endif 

//Filmic tone mapping:
	#if Gamma_FilmicTonemapping

		//Consts:
		#define ShoulderStrength	0.22h
		#define LinStrength			0.30h
		#define LinAngle			0.10h
		#define ToeStrength			0.20h
		#define ToeNumerator		0.01h
		#define ToeDenom			0.30h
		//Helpers:
		#define ToeAngle			0.033333333333333333333333333333333h	// ToeNumerator/ToeDenom
		#define ToeSTmulNUM			0.002h									// ToeStrength * ToeNumerator
		#define ToeSTmulDEN			0.06h									// ToeStrength * ToeDenom
		#define LinAmulLinS			0.03h									//LinAngle * LinStrength
		#define LinearWhite			2.8h									// Original = 11.2h

		half4 basis			= half4(colIn.rgb, LinearWhite);
		half4 colInShoulder = ShoulderStrength * basis;
		half4 toneMapping	 = basis * ( colInShoulder + LinAmulLinS ) + ToeSTmulNUM;
		toneMapping			/= basis * ( colInShoulder + LinStrength ) + ToeSTmulDEN;
		toneMapping			-= ToeAngle;

		finalOut = pow( toneMapping.rgb / toneMapping.a, 1.h / 2.2h );
	#endif

	return finalOut;
}

//---------------------------------------------
//Colour look up table:
//---------------------------------------------
#if XBOX
	sampler3D ColorGradingLUT;
	//  @param InLDRColor in gamma space, has to be in 0..1 range
	half3 ColorLookupTable(half3 InLDRColor)
	{
		return tex3D(ColorGradingLUT, InLDRColor * 15.h / 16.h + 0.5h / 16.h);
	}
#else // XBOX

#define steps 16.h
#define oneoversteps 0.0625h
	sampler2D ColorGradingLUT;
	//  @param InLDRColor in gamma space, has to be in 0..1 range
	half3 ColorLookupTable(half3 InLDRColor)
	{
		// requires a volume texture 16x16x16 unwrapped in a 2d texture 256x16
		// can be optimized by using a volume texture
		half2 Offset = half2(0.5h / 256.h, 0.5h / steps);
		half Scale = 15.h / steps; 

		// Also consider blur value in the blur buffer written by translucency
		half IntB = floor(InLDRColor.b * 14.9999h) / steps;
		half FracB = InLDRColor.b * 15.h - IntB * steps;

		half U = IntB + InLDRColor.r * Scale / steps;
		half V = InLDRColor.g * Scale;

		half3 RG0 = tex2D(ColorGradingLUT, saturate(Offset + half2(U, V))).rgb;
		half3 RG1 = tex2D(ColorGradingLUT, saturate(Offset + half2(U + oneoversteps, V))).rgb;

		return lerp(RG0, RG1, FracB);
	}
#endif // XBOX

