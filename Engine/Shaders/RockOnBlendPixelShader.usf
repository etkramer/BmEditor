//---------------------------------------------
// BLOOM:
//---------------------------------------------
	//FrontBuffer			= computeBloom(FrontBuffer.rgb, blurredSceneColorAndDepth.rgb);
	FrontBuffer				+= tex2D(LightShaftBuffer,FilterBufferUV.xy).rgb;

	//FrontBuffer			= blurredSceneColorAndDepth.a;
//---------------------------------------------
// APPLY GRAIN:
//---------------------------------------------
#if USE_IMAGEGRAIN
	FrontBuffer = lerp(FrontBuffer.rgb, FrontBuffer.rgb * imageGrain.rgb, FilmGrain.w);
#endif // USE_IMAGEGRAIN

//---------------------------------------------
// COLOUR GRADING, TONE MAPPING, AND GAMMA:
//---------------------------------------------
	FrontBuffer = pow(max(0,FrontBuffer), 1.h / 2.2h);
	FrontBuffer = ColorLookupTable(saturate( FrontBuffer));
	
	// NVCHANGE_BEGIN_RS: Add FXAA
	#if PC_D3D
		half luma = dot(FrontBuffer.rgb, float3(0.299, 0.587, 0.114)); // compute luma
		OutColor = RETURN_COLOR( half4(FrontBuffer, luma) );
	#else
		OutColor = RETURN_COLOR( half4(FrontBuffer, 0.h) );
	#endif
	// NVCHANGE_END_RS: Add FXAA
}
