//-----------------------------------------------
// Fog functions: 2D to 3D tex lookup (2 samples)
//-----------------------------------------------
half3 tex2DxyzToUV2(in sampler2D texSampler, in float3 WorldPos1, in float3 WorldPos2)
{
	//half3 noise	= 0;
	//noise += sin(WorldPos1.xyz+WorldPos2.yzx*0.556h);
	//noise -= cos(WorldPos2.xyz+WorldPos1.zxy*0.649h);

	//return dot(noise,noise);


half3 coord1 = WorldPos1.xyz;//+WorldPos2.yzx*0.3556h;
half3 coord2 = WorldPos2.xyz;//+WorldPos1.zxy*0.3649h;

	half3 noise;
	//noise.xy		= tex2D(texSampler, coord1.xy).xy;
	//noise.z			= tex2D(texSampler, noise.xy+coord1.zz).x;

	//noise.xy		+= tex2D(texSampler, coord2.xy).xy;
	//noise.z			+= tex2D(texSampler, tex2D(texSampler, coord2.xy).xy+coord2.zz).x;

	noise.xy		= tex2D(texSampler, coord1.xy).xy;
	noise.z			= tex2D(texSampler, coord1.zz).x;

	noise.xy		-= tex2D(texSampler, coord2.xy).xy;
	noise.z			-= tex2D(texSampler, coord2.zz).x;

	return noise;




