//================================================================================================================================
// Pixel Shader
//================================================================================================================================
void Main(	in half4 ScreenPosition : TEXCOORD0,
			in half3 ScreenVector : TEXCOORD1,
			out half4 OutColor : COLOR0	)
{
	float depth = CalcSceneDepth( ScreenPosition.zw );

//---------------------------------------------
// ATMOSPHERICS:
//---------------------------------------------
	half4 addFogCol			= 0.h;

//@ROCK - JoelS: Replacing old fog with a new density based approx.
//todo: figure out how far it can be broken down into half's
#if ALLOW_AtmosH1 || ALLOW_AtmosH2 || ALLOW_AtmosD1 || ALLOW_AtmosD2

//Get world position from reprojected depth buffer:
	float3 WorldPos				= ScreenVector.xyz * depth;

//Camera to world .xyz difference, and length in .w
	float4 CamToWorldPos;
	CamToWorldPos.xyz			= WorldPos.xyz; 
	CamToWorldPos.w				= length(CamToWorldPos.xyz);
	
	WorldPos					+= CameraPos.xyz;


//Volume noise contribution:
//------------------------------------------------------------------------------------------------------
#if(ALLOW_AtmosNoise)

	#define maxNoiseDistance 6000.h
	#define maxNoiseDistanceHalf 3000.h

	#define texsteps 6
	#define texstepsOneOver 0.166666666666666666666h		// 1 / (texsteps)
	#define texstepsOneOverHalf 0.083333333333333333333h	// 1 / (texsteps)


//-----------------------------
	float4 FogUVDistort = AtmosNoiseWind.xyzw; //eg, float4(TimeVector.xxx * AtmosNoiseWind.xyz, 0.00025h);
//start at the clamped world position...
	float3 startPos		= min(maxNoiseDistance,CamToWorldPos.w) * normalize(-CamToWorldPos.xyz);
	float3 FogUV 		= (startPos.xyz - CameraPos.xyz) * FogUVDistort.w;
	half noiseZ			= 1.h + tex2D(AtmosphericNoiseTexture, FogUV.zz * 0.25h).z;
	FogUV 				= FogUV * noiseZ + FogUVDistort.xyz;

//step out from the world pos towards the camera
	float3 RayStep 		= startPos * FogUVDistort.w * texstepsOneOverHalf;

	half2 slicesSum		= 0.h;
	UNROLL for(int i = 0; i < texsteps; i++)
	{
		slicesSum			+= tex2D(AtmosphericNoiseTexture, FogUV.xy).xy;
		FogUV 				-= RayStep;
	}

	half distExtents	= saturate(maxNoiseDistanceHalf / CamToWorldPos.w);
	slicesSum			= dot(slicesSum,texstepsOneOverHalf);
	slicesSum			= lerp(1, slicesSum, AtmosH1H2_Alpha.z * distExtents);

	AtmosGradSizeHeightIntegral_xH1yH1zH2wH2.yw		*= slicesSum.x;
	//AtmosH1_Colour.rgb *= slicesSum.x;
	//AtmosH2_Colour.rgb *= slicesSum.x;

//
//	#define texsteps 12
//	#define loopsteps 6									// 2 samples at a time
//	#define texstepsOneOver 0.0833333333333333333h		// 1 / (texsteps)
//
////Method: Two sample, world to cam distance clamped instead of xyz
////Turned out quite good!
////-----------------------------
//	float4 FogUVDistort = AtmosNoiseWind.xyzw; //eg, float4(TimeVector.xxx * AtmosNoiseWind.xyz, 0.00025h);
////start at the clamped world position...
//	float3 startPos		= min(3000.h,CamToWorldPos.w) * normalize(-CamToWorldPos.xyz);
//	float3 FogUV1 		= (startPos - CameraPos.xyz) * FogUVDistort.w + FogUVDistort.xyz;
////step out from the world pos towards the camera
//	float3 RayStep 		= startPos * FogUVDistort.w * texstepsOneOver;
////FogUV2 is one step ahead of FogUV1
//	float3 FogUV2 		= FogUV1.xyz - RayStep.xyz;
//
//	half slicesSum		= 0.h;
//
//	UNROLL for(int i = 0; i < loopsteps; i++)
//	{
//		slicesSum 			+= tex2DxyzToUV2(AtmosphericNoiseTexture, FogUV1.xyz, FogUV2.xyz);
//		FogUV1 				-= RayStep;
//		FogUV2 				-= RayStep;
//	}
//	//slicesSum			= lerp(1, slicesSum, AtmosH1H2_Alpha.z);
//	slicesSum			= 1 + AtmosH1H2_Alpha.z * (slicesSum - 1);
#endif //ALLOW_AtmosNoise

#if ALLOW_AtmosH1 && ALLOW_AtmosH2
	addFogCol += ComputeRockAtmosFogH1H2(CamToWorldPos);
#else
	#if ALLOW_AtmosH1
		addFogCol += ComputeRockAtmosFogH1(CamToWorldPos);
	#endif

	#if ALLOW_AtmosH2
		addFogCol += ComputeRockAtmosFogH2(CamToWorldPos);
	#endif
#endif

#if ALLOW_AtmosD1 && ALLOW_AtmosD2
	addFogCol += ComputeRockAtmosFogD1D2(CamToWorldPos);
#else
	#if ALLOW_AtmosD1
		addFogCol += ComputeRockAtmosFogD1(CamToWorldPos);
	#endif

	#if ALLOW_AtmosD2
		addFogCol += ComputeRockAtmosFogD2(CamToWorldPos);
	#endif
#endif
	// Global gradient
	addFogCol.rgba *= lerp(1, AtmosGlobal_Gradient_Colour.rgba, saturate(dot(normalize(WorldPos.xyz), AtmosGlobal_Gradient_Direction.xyz)) );

#endif //ALLOW_AtmosH1 || ALLOW_AtmosH2 || ALLOW_AtmosD1 || ALLOW_AtmosD2

	OutColor = RETURN_COLOR( half4(addFogCol.rgb, saturate(addFogCol.a)) );
}
