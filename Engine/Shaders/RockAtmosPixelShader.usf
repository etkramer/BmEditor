//
//
//	noise.xy = tex2D(texSampler, coord1.xy).xy;
//	noise.z	= tex2D(texSampler, coord1.zz*4 + noise.xy).z;
//
////	noise.xy	-= cos(WorldPos2.xyz+WorldPos1.zxy*0.649h);
//
//	//noise.xyz	= sin(coord1.xyz);
//	return noise.z;//dot(noise,noise); 






	//const float3 RandTable[] = {
	//float3(0.231,0.952,0.580),
	//float3(0.793,0.167,0.687),
	//float3(0.098,0.166,0.169),
