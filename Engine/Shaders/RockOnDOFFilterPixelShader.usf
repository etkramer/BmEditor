//		half4 sampleTap = tex2D(FilterTexture, TapUV.xy);
//
//		half sampleDOFmask = sampleTap.a * 8.h - 1.h;
//		half CircleRadius = abs(sampleDOFmask+0.05h) * MaxSize; //need to add a small offset to avoid 0=full dof
