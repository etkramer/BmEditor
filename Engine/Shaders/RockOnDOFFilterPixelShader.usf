//	half4 TotalSum = 0;
//
//	LOOP for(int i = 0; i < NUM_SAMPLES; i++)
//	{
//		half2 TapUV		= UV.xy + DOFOffset[i].xy;
//		half4 sampleTap	= tex2D(FilterTexture, TapUV.xy);
//		TotalSum		+= sampleTap.rgba;
//	}
//	OutColor = TotalSum / (half)NUM_SAMPLES;
//
//#endif
}
